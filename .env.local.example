# Cricket Tournament Player Registration - Environment Configuration

# Razorpay Payment Gateway Credentials
# Get your test/live keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Tournament Configuration
NEXT_PUBLIC_TOURNAMENT_NAME=Premier Cricket League 2026
NEXT_PUBLIC_TOURNAMENT_EDITION=Season 4 - Mega Player Auction
NEXT_PUBLIC_REGISTRATION_FEE=499
NEXT_PUBLIC_ORGANIZER_PHONE=+919876543210

# Google Sheets Webhook Integration
# Deploy google_apps_script.js as a Web App (Access: Anyone) and paste the URL below
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/AKfycby.../exec
