# ==============================================================================
# CricBid Platform - Environment Configuration Template
# ==============================================================================
# DO NOT commit real secrets, API keys, or production passwords to this file.
# Copy this file to .env.local and populate with your secure credentials.

# ------------------------------------------------------------------------------
# 1. Razorpay Payment Gateway Credentials
# ------------------------------------------------------------------------------
# Obtain your test or live keys from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 2. Super Administrator Authentication
# ------------------------------------------------------------------------------
# Server-only master administrator password (never prefix with NEXT_PUBLIC_)
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=a_random_32_char_cryptographic_secret_here

# ------------------------------------------------------------------------------
# 3. Tournament Default Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TOURNAMENT_NAME=CricBid Premier League 2026
NEXT_PUBLIC_TOURNAMENT_EDITION=Season 2 - Mega Player Auction
NEXT_PUBLIC_REGISTRATION_FEE=150
NEXT_PUBLIC_ORGANIZER_PHONE=+919876543210

# ------------------------------------------------------------------------------
# 4. Google Sheets Cloud Database Integration
# ------------------------------------------------------------------------------
# Deploy google_apps_script.js as a Google Web App and paste the deployment URL:
GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec

# ------------------------------------------------------------------------------
# 5. Supabase Cloud Database Integration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
